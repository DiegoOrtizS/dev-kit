{
  "name": "dev-kit",
  "version": "0.1.0",
  "description": "Agent guard, git guardrails and lint rules shared by my personal repositories",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoOrtizS/dev-kit.git"
  },
  "bin": {
    "dev-kit": "./bin/dev-kit.mjs"
  },
  "exports": {
    "./guard": "./src/guard/guard.mjs",
    "./lint-after-edit": "./src/hooks/lint-after-edit.mjs",
    "./config": "./src/config.mjs",
    "./secrets": "./src/guardrails/rules.mjs",
    "./eslint": "./src/eslint/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "shim"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
